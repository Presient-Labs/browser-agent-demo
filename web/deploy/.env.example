# Workspace-scoped Anthropic key (an org-level key gives 400 "not scoped to a workspace"). Without it the page shows the recorded run.
ANTHROPIC_API_KEY=
# Optional: set the per-million-token rates to current pricing so the $3/day cap is counted accurately.
RATE_INPUT_PER_MTOK=3
RATE_OUTPUT_PER_MTOK=15
