{
  "manifest_version": 3,
  "name": "Records Agent Panel (synthetic demo)",
  "version": "0.1.0",
  "description": "Side-panel chat for a constrained browser agent. Synthetic data only.",
  "key": "",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel"],
  "host_permissions": ["http://127.0.0.1:4200/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Records Agent panel" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:4200 ws://127.0.0.1:4200" }
}
