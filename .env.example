# Copy to .env (git-ignored). Placeholders only - never commit real keys.
# Backend-only secrets: the extension and the UI never see these.

# fake | anthropic | openai(stub, not implemented)
PROVIDER=fake
MODEL=claude-sonnet-5-5
# Explicit approval list, "provider:model" comma-separated. Anything else is rejected before any network call.
APPROVED_MODELS=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=

BACKEND_PORT=4200
SITE_ORIGIN=http://127.0.0.1:4100
SITE_PORT=4100
CDP_PORT=9333

# Budgets
MAX_STEPS=12
MAX_MODEL_CALLS=14
MAX_RETRIES=2
WALL_TIME_MS=120000
MAX_INSPECT_CHARS=4000
MAX_TOTAL_EXTRACTED_CHARS=16000
# Cost ESTIMATE rates, USD per million tokens. PLACEHOLDERS - set to current published pricing.
RATE_INPUT_PER_MTOK=3
RATE_OUTPUT_PER_MTOK=15
